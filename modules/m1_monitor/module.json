{
  "id": "m1_monitor",
  "name": "情报监测",
  "owner": "成员A",
  "enabled": true,
  "entry": "api.py",
  "backend_dirs": ["backend"],
  "web": ["web/panel.js", "web/daily.js", "web/daily.css"],
  "routes": [
    "GET /api/live",
    "GET /api/sources",
    "GET /api/refresh",
